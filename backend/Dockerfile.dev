FROM golang:1.25-alpine

WORKDIR /app

# 配置 Go 环境变量，使用代理加速下载
ENV GOPROXY=https://goproxy.cn,direct

# 复制依赖文件
COPY go.mod go.sum ./
RUN go mod download

# 复制所有源代码
COPY . .

# 直接构建后端服务，不使用文件监听或热重载工具
RUN CGO_ENABLED=0 GOOS=linux go build -o /usr/local/bin/alchat-server ./cmd/server
RUN CGO_ENABLED=0 GOOS=linux go build -o /usr/local/bin/cleanup-theme-config ./cmd/cleanup_theme_config

# 暴露端口
EXPOSE 8080

# 直接启动后端服务
CMD ["/usr/local/bin/alchat-server"]
