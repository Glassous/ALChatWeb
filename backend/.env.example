# Server Configuration
PORT=8080
GIN_MODE=debug # 仅用于兼容 /health 的 gin_mode 字段
ALLOW_ORIGINS=http://localhost:5173,http://localhost:5174 # 用逗号分隔

# MongoDB 配置
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=alchat

# MySQL（沿用旧版 Go DSN 或 mysql+pymysql URL）
MYSQL_DSN=alchat:password@tcp(localhost:3306)/alchat?parseTime=true

# Redis 配置
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# OpenAI Compatible API Configuration
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo

# Expert Mode AI Configuration
EXPERT_API_KEY=your-expert-api-key-here
EXPERT_BASE_URL=https://api.openai.com/v1
EXPERT_MODEL=gpt-4

# Auth Configuration
JWT_SECRET=your_jwt_secret_here
CUSTOM_MODEL_ENCRYPTION_KEY=use_a_long_random_secret_distinct_from_jwt_secret

# SMTP Configuration (QQ Mail)
# QQ邮箱授权码获取: 登录 mail.qq.com → 设置 → 账户 → POP3/SMTP服务 → 生成授权码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-email@qq.com
SMTP_PASS=your-16-digit-auth-code
SMTP_FROM=AL Chat <your-email@qq.com>

# Title AI Configuration (Optional, defaults to OpenAI configuration)
TITLE_AI_MODEL=gpt-3.5-turbo
TITLE_AI_BASE_URL=https://api.openai.com/v1
TITLE_AI_API_KEY=your-api-key-here

# Tencent Cloud COS Configuration
COS_SECRET_ID=your-cos-secret-id
COS_SECRET_KEY=your-cos-secret-key
COS_BUCKET=your-cos-bucket-name
COS_REGION=ap-beijing
COS_CUSTOM_DOMAIN=yourdomain.com

# Only selects request format: openai -> /images/generations or /images/edits;
# openrouter -> /images. Both use the BASE_URL, API_KEY and MODEL below as configured.
OPENAI_IMAGES_PROTOCOL=openai
OPENAI_IMAGES_API_KEY=your-images-api-key
OPENAI_IMAGES_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGES_MODEL=your-images-model
# BASE_URL can point to your own gateway's API root for either protocol.
# For direct OpenRouter access, https://openrouter.ai/api/v1 is one possible BASE_URL.

# Bocha AI Search Configuration
BOCHA_API_KEY=your-bocha-api-key

# Tavily International Search Configuration
TAVILY_API_KEY=your-tavily-api-key

# Agent 复用日常模型；仅后端执行，单 worker 部署
AGENT_MAX_MODEL_CALLS=16
AGENT_MAX_SEARCH_CALLS=12
AGENT_MAX_PLUGIN_CALLS=24
AGENT_TIMEOUT_SECONDS=600
AGENT_MODEL_TIMEOUT_SECONDS=60
AGENT_SEARCH_TIMEOUT_SECONDS=30
AGENT_PLUGIN_TIMEOUT_SECONDS=30
AGENT_DISCOVERY_TIMEOUT_SECONDS=10
AGENT_FINAL_RESERVE_SECONDS=60
SUPERBOX_ENABLED=true
SUPERBOX_BASE_URL=https://superbox.fiacloud.top/api/v1

# Search Mode AI Configuration
SEARCH_API_KEY=your-search-api-key
SEARCH_BASE_URL=https://api.openai.com/v1
SEARCH_MODEL=gpt-4

# 多模态模型配置
MULTIMODAL_API_KEY=your-api-key-here
MULTIMODAL_BASE_URL=https://api.openai.com/v1
MULTIMODAL_MODEL=gpt-4o

# ALing 模型配置 (用于创作演示等功能)
ALING_API_KEY=your-api-key-here
ALING_BASE_URL=https://api.openai.com/v1
ALING_MODEL=gpt-4o

